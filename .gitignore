.env
.qodo
.claude
.ropeproject
.vscode/*
.vs/*
pyrightconfig.json

# cache
__pycache__
*.pyc
*/.DS_Store
.DS_Store

# state
ntpLastSync.txt
*.pck
*.parquet
*/.ipynb_checkpoints

# external deployment
helao/deploy/*
!helao/deploy/__init__.py
!helao/deploy/hte/
!helao/deploy/test/
!helao/deploy/hexagon/

# superpowers brainstorm/companion artifacts
.superpowers

# oh-my-claudecode
.omc
.coverage
.framework-cov.json

# local test artifacts
C:*

.pytest_cache
# understand-anything knowledge-graph output (regenerated on demand;
# ~9.5 MB of generated JSON, not worth versioning)
.understand-anything/

# Exported Reflex frontend bundle; built per-machine, shipped as a release
# artifact rather than tracked. See reflex_launcher.py.
.reflex-bundle/

# xy's ESM render client, copied out of the installed wheel at build time.
# Generated artifact, ~411 KB — never tracked.
helao/core/servers/reflex/_app/assets/xy-client.js

# Reflex's own build directory and the artifacts `reflex init` generates.
# AGENTS.md/CLAUDE.md are excluded deliberately: a nested CLAUDE.md is loaded as
# project instructions, and a generated one would inject unrelated guidance.
helao/core/servers/reflex/_app/.web/
helao/core/servers/reflex/_app/.gitignore
helao/core/servers/reflex/_app/AGENTS.md
helao/core/servers/reflex/_app/CLAUDE.md
helao/core/servers/reflex/_app/reflex.lock/
helao/core/servers/reflex/_app/requirements.txt

# Lock serializing concurrent frontend builds, which share this one `.web`
# tree. Must stay ignored: `git status --porcelain` feeds the bundle staleness
# stamp, so a tracked lockfile would make every build invalidate its own stamp.
helao/core/servers/reflex/_app/.reflex-build.lock
helao/core/servers/reflex/_app/.reflex-build.lock.owner

# Probe written and deleted to find out whether this checkout is mounted
# `noexec`. Ignored for the same reason as the lock: it must never reach a
# `git status --porcelain` that the stamp hashes.
.helao_exec_probe

# Built Reflex frontend bundle. A local artifact of build_reflex_bundle.py,
# rebuilt per station because it bakes that config's backend URL.
.reflex-bundle/
