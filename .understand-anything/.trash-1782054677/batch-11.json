      "complexity": "moderate"
    },
    {
      "id": "file:helao/helpers/openapi_client.py",
      "type": "file",
      "name": "openapi_client.py",
      "filePath": "helao/helpers/openapi_client.py",
      "summary": "Dynamic OpenAPI client that fetches a server's spec and synthesizes typed sync/async methods per operation, handling request building, query quoting, response parsing, and pagination.",
      "tags": ["openapi-client", "http-client", "factory", "service", "pagination"],
      "complexity": "complex",
      "languageNotes": "Builds API methods at runtime via setattr and method_function.__get__ to bind dynamically generated functions to the instance; sync and async clients share a common _BaseOpenAPIClient and override _fetch_spec / _raw_request / _make_method."
    },
