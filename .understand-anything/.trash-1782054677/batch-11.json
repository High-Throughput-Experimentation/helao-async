      "name": "openapi_client_test.py",
      "filePath": "helao/core/tests/openapi_client_test.py",
      "summary": "Standalone test script that exercises the sync and async OpenAPI clients against an in-process httpx MockTransport, covering item fetch/create, error handling, and cursor pagination.",
      "tags": ["test", "openapi-client", "http-mock", "pagination"],
      "complexity": "complex",
      "languageNotes": "Uses httpx.MockTransport monkeypatched onto httpx.Client/AsyncClient to run network-free, and a local _failures list as a lightweight assertion harness instead of pytest."
    },
    {
